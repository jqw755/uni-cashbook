<view class="container"><navbar vue-id="1" bind:__l="__l" vue-slots="{{['contentText']}}"><view slot="contentText">联系人</view></navbar><view class="contacts-wrap"><scroll-view class="contacts-swiper-wrap" style="{{'height:'+('calc(100vh - '+customeBarH+'px)')+';'}}" scroll-y scroll-into-view="{{'index-'+indexCur}}" scroll-with-animation enable-back-to-top><block wx:for="{{contactData}}" wx:for-item="list" wx:for-index="letter" wx:key="letter"><view id="{{'index-'+letter}}"><view class="letter-wrap flex flex-align">{{letter}}</view><view class="contact-people-wrap"><block wx:for="{{list}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="contact-people-item flex flex-align"><image class="contact-avatar" src="/static/contact-avatar.png" mode></image><view class="contact-people">{{item.name}}</view></view></block></view></view></block></scroll-view><view class="contacts-index-wrap flex flex-align flex-justify" style="{{'height:'+('calc(100vh - '+customeBarH+'px)')+';'}}"><view data-event-opts="{{[['touchstart',[['touchUlStart',['$event']]]],['touchmove',[['touchUlMove',['$event']]]],['touchend',[['touchUlEnd',['$event']]]]]}}" class="contacts-ul box-shadow _ul" bindtouchstart="__e" bindtouchmove="__e" catchtouchend="__e"><block wx:for="{{contactIndexData}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="index-item flex flex-align flex-justify _li" data-id="{{item}}" data-event-opts="{{[['touchstart',[['touchIdxItem',['$event']]]]]}}" bindtouchstart="__e">{{item}}</view></block></view></view><view hidden="{{!(isShowTipBox)}}" class="index-tip-wrap flex flex-align flex-justify">{{indexCur}}</view></view></view>