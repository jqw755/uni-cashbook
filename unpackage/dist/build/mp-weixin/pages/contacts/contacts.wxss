.contacts-wrap{width:100%;background-color:#f1f1f1}.contacts-wrap .contacts-swiper-wrap .letter-wrap{-webkit-box-flex:1;-webkit-flex:1;-ms-flex:1;flex:1;font-size:24rpx;color:#999;height:90rpx;padding:0 32rpx}.contacts-wrap .contacts-swiper-wrap .contact-people-wrap{padding:0 0 0 32rpx;background-color:#fff;border-top:1px solid #d8d8d8;border-bottom:1px solid #d8d8d8}.contacts-wrap .contacts-swiper-wrap .contact-people-wrap .contact-people-item{height:110rpx;margin-left:70rpx;border-bottom:1px solid #d8d8d8}.contacts-wrap .contacts-swiper-wrap .contact-people-wrap .contact-people-item:last-child{border-bottom:0}.contacts-wrap .contacts-swiper-wrap .contact-people-wrap .contact-people-item .contact-avatar{width:70rpx;height:70rpx;margin-left:-70rpx}.contacts-wrap .contacts-swiper-wrap .contact-people-wrap .contact-people-item .contact-people{padding-left:20rpx}.contacts-wrap .contacts-index-wrap{-webkit-box-orient:vertical;-webkit-box-direction:normal;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;position:fixed;right:32rpx;top:0}.contacts-wrap .contacts-index-wrap .contacts-ul{color:#888;padding:16rpx 0;border-radius:6rpx;background:#fff;font-size:24rpx}.contacts-wrap .contacts-index-wrap .contacts-ul .index-item{width:50rpx;height:40rpx}.contacts-wrap .index-tip-wrap{width:100rpx;height:100rpx;border-radius:6rpx;color:#fff;font-size:32rpx;background:rgba(0,0,0,.7);position:fixed;left:50%;top:50%;-webkit-transform:translate(-50%,-50%);-ms-transform:translate(-50%,-50%);transform:translate(-50%,-50%)}