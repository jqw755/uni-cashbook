<block a:if="{{isShowDialogData}}"><view class="dialog-wrap data-v-31072abc"><view data-event-opts="{{[['tap',[['tapMask',['$event']]]]]}}" class="dialog-mask data-v-31072abc" onTap="__e"></view><view class="dialog-content-wrap data-v-31072abc"><view class="dialog-title data-v-31072abc"><block a:if="{{$slots.title}}"><slot name="title"></slot></block><block a:else>提示</block></view><view class="dialog-content data-v-31072abc"><slot name="content"></slot></view><view class="footer-btn data-v-31072abc"><block a:if="{{isShowCancelBtn}}"><view class="btn cancel-btn data-v-31072abc" hover-class="current" data-event-opts="{{[['tap',[['cancelEvt',['$event']]]]]}}" onTap="__e">取消<text class="line data-v-31072abc"></text></view></block><view class="btn confirm-btn data-v-31072abc" hover-class="current" data-event-opts="{{[['tap',[['confirmEvt',['$event']]]]]}}" onTap="__e">确定</view></view></view></view></block>