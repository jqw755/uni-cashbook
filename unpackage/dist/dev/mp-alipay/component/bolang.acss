/* 文章场景相关 */
.bolang-wrap {
  width: 100%;
  height: 100%;
  min-height: 200rpx;
  margin: 0 auto;
  background-image: -webkit-linear-gradient(250deg, #007851, #14a032);
  background-image: linear-gradient(200deg, #007851, #14a032);
  overflow: hidden;
  position: relative;
}
.bolang-wrap:before, .bolang-wrap:after {
    content: "";
    display: inline-block;
    width: calc(100vw + 400rpx);
    height: calc(100vw + 400rpx);
    background: rgba(255, 255, 255, 0.8);
    border-radius: 44%;
    position: absolute;
    left: 50%;
    top: 0;
    -webkit-transform: translate(-50%, -70%) rotate(0deg);
            transform: translate(-50%, -70%) rotate(0deg);
    -webkit-animation: bolangAnimate 10s linear infinite;
            animation: bolangAnimate 10s linear infinite;
    z-index: 2;
}
.bolang-wrap:after {
    background: rgba(255, 255, 255, 0.6);
    border-radius: 46%;
    -webkit-animation: bolangAnimate 12s linear infinite;
            animation: bolangAnimate 12s linear infinite;
    z-index: 3;
}
@-webkit-keyframes bolangAnimate {
50% {
    -webkit-transform: translate(-50%, -73%) rotate(180deg);
            transform: translate(-50%, -73%) rotate(180deg);
}
100% {
    -webkit-transform: translate(-50%, -70%) rotate(360deg);
            transform: translate(-50%, -70%) rotate(360deg);
}
}
@keyframes bolangAnimate {
50% {
    -webkit-transform: translate(-50%, -73%) rotate(180deg);
            transform: translate(-50%, -73%) rotate(180deg);
}
100% {
    -webkit-transform: translate(-50%, -70%) rotate(360deg);
            transform: translate(-50%, -70%) rotate(360deg);
}
}

