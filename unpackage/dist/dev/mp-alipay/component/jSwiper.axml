<view class="j-swiper-container"><view data-event-opts="{{[['touchStart',[['touchSwiperItem',['$event']]]],['touchMove',[['moveSwiperItem',['$event']]]],['touchEnd',[['endSwiperItem',['$event']]]],['transitionEnd',[['bindTransitionEnd',['$event']]]]]}}" class="{{(('j-swiper-wrap flex')+' '+[(isMoveEnd)?'move':''])}}" style="{{'width:'+(swiperWrapWidth+'px')+';'+('transform:'+('translateX('+(swiperLeft+swiperDis)+'px)')+';')}}" onTouchStart="__e" onTouchMove="__e" onTouchEnd="__e" onTransitionEnd="__e"><slot></slot></view></view>