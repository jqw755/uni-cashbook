.dialog-wrap.data-v-31072abc {
  width: 100%;
  height: 100%;
  position: fixed;
  top: 0;
  left: 0;
  z-index: 100;
}
.dialog-wrap .dialog-mask.data-v-31072abc {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    transform-origin: center;
    -webkit-transform-origin: center;
    animation: opacityAni-data-v-31072abc 200ms ease;
    -webkit-animation: opacityAni-data-v-31072abc 200ms ease;
    animation-fill-mode: forwards;
    -webkit-animation-fill-mode: forwards;
}
.dialog-wrap .dialog-content-wrap.data-v-31072abc {
    width: 75%;
    max-width: 750px;
    font-size: 26rpx;
    background: #fff;
    border-radius: 12rpx;
    position: absolute;
    top: 20%;
    left: 12.5%;
    transform-origin: center;
    -webkit-transform-origin: center;
    animation: zoomIn-data-v-31072abc 200ms ease;
    -webkit-animation: zoomIn-data-v-31072abc 200ms ease;
    animation-fill-mode: forwards;
    -webkit-animation-fill-mode: forwards;
    overflow: hidden;
}
.dialog-wrap .dialog-content-wrap .dialog-title.data-v-31072abc {
      font-size: 32rpx;
      text-align: center;
      color: #333;
      padding: 30rpx 0 32rpx 0;
}
.dialog-wrap .dialog-content-wrap .dialog-content.data-v-31072abc {
      padding: 0 36rpx;
}
.dialog-wrap .dialog-content-wrap .footer-btn.data-v-31072abc {
      display: -webkit-box;
      display: -webkit-flex;
      display: flex;
      -webkit-box-orient: horizontal;
      -webkit-box-direction: normal;
      -webkit-flex-direction: row;
              flex-direction: row;
      height: 98rpx;
      line-height: 98rpx;
      border-top: 1px solid #e7e8e9;
      font-size: 32rpx;
      margin-top: 32rpx;
      text-align: center;
}
.dialog-wrap .dialog-content-wrap .footer-btn .btn.data-v-31072abc {
        -webkit-box-flex: 1;
        -webkit-flex: 1;
                flex: 1;
        height: 100%;
        text-align: center;
        position: relative;
}
.dialog-wrap .dialog-content-wrap .footer-btn .btn.current.data-v-31072abc {
          background: #f4f4f4;
}
.dialog-wrap .dialog-content-wrap .footer-btn .cancel-btn.data-v-31072abc {
        color: #999;
        font-weight: normal;
}
.dialog-wrap .dialog-content-wrap .footer-btn .line.data-v-31072abc {
        width: 1px;
        height: 100%;
        background: #e7e8e9;
        position: absolute;
        right: 0;
        top: 0;
}
.dialog-wrap .dialog-content-wrap .footer-btn .confirm-btn.data-v-31072abc {
        color: #3fbc62;
}
@-webkit-keyframes opacityAni-data-v-31072abc {
from {
    background: rgba(0, 0, 0, 0.1);
}
to {
    background: rgba(0, 0, 0, 0.55);
}
}
@keyframes opacityAni-data-v-31072abc {
from {
    background: rgba(0, 0, 0, 0.1);
}
to {
    background: rgba(0, 0, 0, 0.55);
}
}
@-webkit-keyframes zoomIn-data-v-31072abc {
from {
    -webkit-transform: scale(0.96);
            transform: scale(0.96);
}
to {
    -webkit-transform: scale(1);
            transform: scale(1);
}
}
@keyframes zoomIn-data-v-31072abc {
from {
    -webkit-transform: scale(0.96);
            transform: scale(0.96);
}
to {
    -webkit-transform: scale(1);
            transform: scale(1);
}
}

