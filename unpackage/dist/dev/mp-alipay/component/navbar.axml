<view class="nav-bar-wrap" style="{{'height:'+(customeBar+'px')+';'}}"><view class="nav-bar-fixed-wrap flex flex-align" style="{{(style)}}"><block a:if="{{isShowBack}}"><view data-event-opts="{{[['tap',[['backPage',['$event']]]]]}}" class="nav-left-wrap" onTap="__e"><text class="icons icon-fanhui"></text><block a:if="{{$slots.backText}}"><slot name="backText"></slot></block><block a:else>返回</block></view></block><view class="nav-content-wrap text-overflow"><slot name="contentText"></slot></view><view class="nav-right-wrap"><slot name="rightText"></slot></view></view></view>