<view class="datetime-picker"><view class="{{(('mask')+' '+((open)?'show':''))}}" catchtouchmove="true" data-event-opts="{{[['touchMove',[['',['$event']]]],['tap',[['e0',['$event']]]]]}}" catchTouchMove="__e" onTap="__e"></view><view class="{{(('wrap')+' '+((open)?'show':''))}}"><view class="picker-header" catchtouchmove="true" data-event-opts="{{[['touchMove',[['',['$event']]]]]}}" catchTouchMove="__e"><view data-event-opts="{{[['tap',[['e1',['$event']]]]]}}" class="btn-picker cancel" style="{{'color:'+(color)+';'}}" onTap="__e">取消</view><view data-event-opts="{{[['tap',[['_onSubmit',['$event']]]]]}}" class="btn-picker submit" style="{{'background-color:'+(color)+';'}}" onTap="__e">确定</view></view><view class="picker-body"><picker-view value="{{value}}" data-event-opts="{{[['change',[['_onChange',['$event']]]]]}}" onChange="__e"><picker-view-column><block a:for="{{years}}" a:for-item="item" a:for-index="index" a:key="index"><view class="column-item">{{item+"年"}}</view></block></picker-view-column><picker-view-column><block a:for="{{$root.l0}}" a:for-item="item" a:for-index="index" a:key="index"><view class="column-item">{{item.f0+"月"}}</view></block></picker-view-column><picker-view-column><block a:for="{{$root.l1}}" a:for-item="item" a:for-index="index" a:key="index"><view class="column-item">{{item.f1+"日"}}</view></block></picker-view-column><picker-view-column><block a:for="{{$root.l2}}" a:for-item="item" a:for-index="index" a:key="index"><view class="column-item">{{item.f2+"时"}}</view></block></picker-view-column><picker-view-column><block a:for="{{$root.l3}}" a:for-item="item" a:for-index="index" a:key="index"><view class="column-item">{{item.f3+"分"}}</view></block></picker-view-column></picker-view></view></view></view>