<view class="expenditure-wrap flex"><block a:for="{{expenditureList}}" a:for-item="item" a:for-index="index" a:key="index"><view data-event-opts="{{[['tap',[['chooseExpenditure',['$0'],[[['expenditureList','',index]]]]]]]}}" class="{{(('expenditure-item')+' '+[(item.id===selectedId)?'active':''])}}" onTap="__e"><view class="{{(('icons')+' '+item.icon)}}"></view><view class="expenditure-name">{{item.name}}</view></view></block></view>