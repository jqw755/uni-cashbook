/* 垂直间距 */
/* 透明度 */
/* 文章场景相关 */
.rili-wrap {
  width: 100rpx;
  max-height: 120rpx;
  font-size: 28rpx;
}
.rili-wrap .guagou {
    width: 100%;
    height: 30rpx;
    padding: 0 16rpx;
    -webkit-box-pack: justify;
    -webkit-justify-content: space-between;
            justify-content: space-between;
    background: #0ec08e;
    border-top-left-radius: 10rpx;
    border-top-right-radius: 10rpx;
    position: relative;
}
.rili-wrap .guagou .hole {
      width: 14rpx;
      height: 14rpx;
      background: #11503f;
      border-radius: 50%;
}
.rili-wrap .guagou .rope {
      width: calc(100% - 36rpx);
      height: 6rpx;
      border-radius: 4rpx;
      background: #fff;
      position: absolute;
      left: 50%;
      top: 50%;
      -webkit-transform: translate(-50%, -50%);
              transform: translate(-50%, -50%);
}
.rili-wrap .rili-content {
    height: 80rpx;
    border: 4rpx solid #f9be26;
    background: #FFFFFF;
    border-bottom-left-radius: 6rpx;
    border-bottom-right-radius: 6rpx;
    border-top: 0;
    position: relative;
}
.rili-wrap .rili-content .date-wrap,
    .rili-wrap .rili-content .decor-wrap {
      width: 100%;
      height: 100%;
      font-size: 20rpx;
      position: absolute;
      left: 0;
      top: 0;
      z-index: 2;
}
.rili-wrap .rili-content .date-wrap .weekly,
      .rili-wrap .rili-content .decor-wrap .weekly {
        padding: 4rpx 0 0 0;
}
.rili-wrap .rili-content .date-wrap .date,
      .rili-wrap .rili-content .decor-wrap .date {
        font-size: 34rpx;
        font-weight: bold;
}
.rili-wrap .rili-content .decor-wrap {
      z-index: 1;
}
.rili-wrap .rili-content .decor-wrap .decor-item {
        display: inline-block;
        width: 30rpx;
        height: 18rpx;
        background: #e6e6e6;
        position: absolute;
        left: 12rpx;
        top: 12rpx;
}
.rili-wrap .rili-content .decor-wrap .decor-item:nth-child(2) {
          left: 25rpx;
          top: 48rpx;
          background: #ffece5;
}
.rili-wrap .rili-content .decor-wrap .decor-item:nth-child(3) {
          left: 56rpx;
          top: 22rpx;
          background: #daf2d6;
}

