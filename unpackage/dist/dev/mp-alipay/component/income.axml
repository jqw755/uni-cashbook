<view class="income-wrap flex"><block a:for="{{incomeList}}" a:for-item="item" a:for-index="index" a:key="index"><view data-event-opts="{{[['tap',[['chooseIncome',['$0'],[[['incomeList','',index]]]]]]]}}" class="{{(('income-item')+' '+[(item.id===selectedId)?'active':''])}}" onTap="__e"><view class="{{(('icons')+' '+item.icon)}}"></view><view class="income-name">{{item.name}}</view></view></block></view>