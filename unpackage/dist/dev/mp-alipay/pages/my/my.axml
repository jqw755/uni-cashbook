<view class="user-container"><view class="user-info-wrap flex flex-align flex-justify"><image class="user-info-bg" src="/static/default-user-head-bg.jpg" mode="aspectFill"></image><view class="user-head-wrap"><view class="top-info flex flex-align"><view class="family-info flex flex-align"><text>来自</text><block a:if="{{userData.familyAvatar}}"><image class="family-avatar" src="{{userData.familyAvatar}}" mode></image></block><block a:else><image class="family-avatar" src="/static/family/home.png" mode></image></block><text>{{userData.familyName||'--'}}</text></view><navigator class="set-btn" url="/pages/my/set">设置</navigator></view><view class="greet-tip">{{greetings}}</view><view class="middle-info text-center"><view data-event-opts="{{[['tap',[['actionUploadAvatar',[true]]]]]}}" onTap="__e"><block a:if="{{userData.avatar}}"><image class="user-avatar" src="{{userData.avatar}}" mode></image></block><block a:else><image class="user-avatar" src="/static/family/default-head-bg.jpg" mode></image></block></view><view class="user-name">{{userData.userName||'--'}}</view></view></view></view><view class="fun-wrap"><view class="fun-tab-wrap flex flex-align flex-justify"><block a:for="{{tabList}}" a:for-item="item" a:for-index="index" a:key="index"><text data-event-opts="{{[['tap',[['changeTab',['$0'],[[['tabList','',index,'id']]]]]]]}}" class="{{(('tab-item')+' '+[(item.id===currentTab)?'active':''])}}" onTap="__e">{{item.name}}</text></block></view><j-swiper vue-id="1" swiperLen="{{2}}" swiperIdx="{{currentTab}}" data-event-opts="{{[['^swiperChange',[['swiperChange']]]]}}" onSwiperChange="__e" onVueInit="__l"><view class="j-swiper-item"><view class="balance-container"><view class="balance-wrap"><view class="money-title"><text>当前余额（元）</text></view><view class="money-count">{{$store.state.userInfo.balance}}</view></view></view><view class="my-fun-wrap"><view class="my-fun-item is-open-index-ani"><text>首页动画</text><switch class="open-index-switch f-right" color="#00d18b" checked="{{$store.state.isOpenIndexAni}}" data-event-opts="{{[['change',[['isOpenIndexAniEvt',['$event']]]]]}}" onChange="__e"></switch></view></view></view><view class="j-swiper-item"><block a:if="{{!photos.length}}"><view class="my-page-order-wrap"><empty-data vue-id="{{('2')+','+('1')}}" noDataDesc="暂无相册" onVueInit="__l"></empty-data></view></block></view></j-swiper></view><block a:if="{{isShowUploadAvatar}}"><view class="big-avatar-wrap flex flex-justify"><view data-event-opts="{{[['tap',[['actionUploadAvatar',[false]]]]]}}" class="mask" onTap="__e"></view><view class="avatar-content"><view class="big-user-avatar-wrap"><block a:if="{{userData.avatar}}"><image class="big-user-avatar" src="{{userData.avatar}}" mode></image></block><block a:else><image class="big-user-avatar" src="/static/family/default-head-bg.jpg" mode="widthFix"></image></block></view><view data-event-opts="{{[['tap',[['changeAvatar',['$event']]]]]}}" class="update-avatar-tip text-center" onTap="__e">更换头像</view></view></view></block></view>