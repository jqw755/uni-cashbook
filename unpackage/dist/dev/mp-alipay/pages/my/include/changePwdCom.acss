.member-register .login_form {
  margin: 40rpx auto;
  -webkit-box-orient: vertical;
  -webkit-box-direction: normal;
  -webkit-flex-direction: column;
          flex-direction: column;
  border: 1px solid #d6d6d6;
  border-radius: 20rpx;
}
.member-register .login_form .line {
    width: 100%;
    height: 1px;
    background-color: #d6d6d6;
}
.member-register .login_form .input-wrap {
    width: 100%;
    max-height: 90rpx;
    padding: 18rpx 0 18rpx 30rpx;
}
.member-register .login_form .input-wrap .img {
      min-width: 40px;
      min-height: 40px;
      margin: 5px;
      display: -webkit-box;
      display: -webkit-flex;
      display: flex;
      -webkit-box-align: center;
      -webkit-align-items: center;
              align-items: center;
      -webkit-box-pack: center;
      -webkit-justify-content: center;
              justify-content: center;
}
.member-register .login_form .input-wrap .img_del {
      width: 32rpx;
      height: 32rpx;
}
.member-register .login_form .input-wrap .img_pwd_switch {
      width: 48rpx;
      height: 48rpx;
}
.member-register .login_form .input-wrap input {
      height: 60rpx;
      width: 100%;
}
.member-register .submit-login {
  margin-top: 70rpx auto 50rpx;
  color: white;
  background-color: #fc2c5d;
  -webkit-tap-highlight-color: #fc2c5d;
}
.member-register .submit-login:active {
    color: #b6b6b6;
    background-color: rgba(252, 44, 93, 0.8);
}
.member-register .opts {
  margin: 30rpx 48rpx;
  text-align: right;
}
.member-register .opts .text {
    font-size: 14px;
    color: #fc2c5d;
}

