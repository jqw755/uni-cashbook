<view><j-dialog vue-id="1" isShowDialog="{{isShowDialog}}" isShowCancelBtn="{{true}}" isMaskClose="{{false}}" data-event-opts="{{[['^closeDialog',[['closeDialog']]],['^confirmDialog',[['changePwdEvt']]]]}}" onCloseDialog="__e" onConfirmDialog="__e" onVueInit="__l"><text slot="title">修改密码</text><view slot="content"><view class="member-register"><view class="login_form flex flex-align flex-justify"><view class="input-wrap flex flex-align flex-justify"><input type="password" placeholder="请输入当前账号密码" data-event-opts="{{[['input',[['__set_model',['','userpwd','$event',[]]],['inputPwd',['$event']]]]]}}" value="{{userpwd}}" onInput="__e"/></view><view class="line"></view><view class="input-wrap flex flex-align flex-justify"><input type="{{pwdType}}" placeholder="请输入新密码" data-event-opts="{{[['input',[['inputNewPwd',['$event']]]]]}}" value="{{newPwd}}" onInput="__e"/><view data-event-opts="{{[['tap',[['switchPwd',['$event']]]]]}}" class="img" onTap="__e"><image hidden="{{!(pwdType==='password')}}" class="img_pwd_switch" src="/static/login/close-pwd.png"></image><image hidden="{{!(pwdType==='text')}}" class="img_pwd_switch" src="/static/login/open-pwd.png"></image></view></view><view class="line"></view><view class="input-wrap flex flex-align flex-justify"><input type="password" placeholder="请输入确认密码" data-event-opts="{{[['input',[['inputConfirmPwd',['$event']]]]]}}" value="{{userConfirmPwd}}" onInput="__e"/></view></view></view></view></j-dialog></view>