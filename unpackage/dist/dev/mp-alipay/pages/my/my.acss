@charset "UTF-8";
/**
 * 这里是uni-app内置的常用样式变量
 *
 * uni-app 官方扩展插件及插件市场（https://ext.dcloud.net.cn）上很多三方插件均使用了这些样式变量
 * 如果你是插件开发者，建议你使用scss预处理，并在插件代码中直接使用这些变量（无需 import 这个文件），方便用户通过搭积木的方式开发整体风格一致的App
 *
 */
/**
 * 如果你是App开发者（插件使用者），你可以通过修改这些变量来定制自己的插件主题，实现自定义主题功能
 *
 * 如果你的项目同样使用了scss预处理，你也可以直接在你的 scss 代码中使用如下变量，同时无需 import 这个文件
 */
/* 颜色变量 */
/* 行为相关颜色 */
/* 文字基本颜色 */
/* 背景颜色 */
/* 边框颜色 */
/* 分割线颜色 */
/* 尺寸变量 */
/* 文字尺寸 */
/* 图片尺寸 */
/* Border Radius */
/* 水平间距 */
/* 垂直间距 */
/* 透明度 */
/* 文章场景相关 */
.user-container {
  width: 100%;
  background: #f4f4f4;
}
.user-container .user-info-wrap {
    width: 100%;
    height: 420rpx;
    overflow: hidden;
    position: relative;
}
.user-container .user-info-wrap .user-info-bg {
      width: 100%;
      position: absolute;
      left: 0;
      top: 0;
      z-index: 1;
}
.user-container .user-info-wrap .user-head-wrap {
      width: 100%;
      height: 100%;
      padding: 24rpx 24rpx;
      position: relative;
      z-index: 2;
      color: #ffffff;
      font-size: 24rpx;
      text-shadow: 0 0 4rpx rgba(0, 0, 0, 0.6);
      background: rgba(0, 0, 0, 0.22);
}
.user-container .user-info-wrap .user-head-wrap .top-info {
        -webkit-box-pack: justify;
        -webkit-justify-content: space-between;
                justify-content: space-between;
        margin-bottom: 10rpx;
}
.user-container .user-info-wrap .user-head-wrap .top-info .family-info {
          -webkit-flex-shrink: 0;
                  flex-shrink: 0;
          padding: 4rpx 20rpx;
          margin: 0 10rpx 0 0;
          background: rgba(0, 0, 0, 0.3);
          border-radius: 200rpx;
}
.user-container .user-info-wrap .user-head-wrap .top-info .family-info .family-avatar {
            width: 34rpx;
            height: 34rpx;
            margin: 0 2rpx 0 4rpx;
}
.user-container .user-info-wrap .user-head-wrap .greet-tip {
        padding: 0 20rpx;
        font-size: 28rpx;
}
.user-container .user-info-wrap .user-head-wrap .middle-info .user-avatar {
        width: 146rpx;
        height: 146rpx;
        border: 4rpx solid rgba(244, 244, 244, 0.5);
        border-radius: 50%;
        overflow: hidden;
        box-shadow: 0 0 4rpx 4rpx rgba(0, 0, 0, 0.1);
}
.user-container .user-info-wrap .user-head-wrap .middle-info .user-name {
        font-size: 30rpx;
        margin: 14rpx 0;
}
.user-container .fun-wrap .fun-tab-wrap {
    position: -webkit-sticky;
    position: sticky;
    top: 0;
    background: #fff;
    margin-bottom: 30rpx;
}
.user-container .fun-wrap .fun-tab-wrap .tab-item {
      text-align: center;
      -webkit-flex-basis: 100rpx;
              flex-basis: 100rpx;
      height: 80rpx;
      line-height: 80rpx;
      color: gray;
      font-size: 26rpx;
      position: relative;
}
.user-container .fun-wrap .fun-tab-wrap .tab-item.active {
        color: orange;
}
.user-container .fun-wrap .fun-tab-wrap .tab-item.active:after {
          content: '';
          display: block;
          width: 40%;
          height: 4rpx;
          background: orange;
          position: absolute;
          left: 50%;
          -webkit-transform: translateX(-50%);
                  transform: translateX(-50%);
          bottom: 0;
}
.user-container .fun-wrap .j-swiper-item {
    min-height: calc(100vh - 530rpx);
}
.user-container .fun-wrap .fun-list {
    background: #fff;
}
.user-container .fun-wrap .fun-list .fun-item {
      display: -webkit-box;
      display: -webkit-flex;
      display: flex;
      -webkit-box-align: center;
      -webkit-align-items: center;
              align-items: center;
      height: 100rpx;
      padding: 0 32rpx;
      border-bottom: 1px solid #f1f1f1;
}
.user-container .fun-wrap .fun-list .fun-item:last-child {
        border-bottom: 0;
}
.user-container .balance-container {
    background: #fff;
    padding: 30rpx 26rpx;
}
.user-container .balance-container .balance-wrap {
      padding: 30rpx 40rpx;
      background: #2dc478;
      border-top-left-radius: 26rpx;
      border-top-right-radius: 26rpx;
      color: #fff;
}
.user-container .balance-container .balance-wrap .money-title {
        font-size: 26rpx;
        margin-bottom: 10rpx;
}
.user-container .balance-container .balance-wrap .money-count {
        font-weight: bold;
        font-size: 56rpx;
}
.user-container .my-fun-wrap {
    margin-top: 16rpx;
    background: #f4f4f4;
}
.user-container .my-fun-wrap .my-fun-item {
      display: -webkit-box;
      display: -webkit-flex;
      display: flex;
      -webkit-box-align: center;
      -webkit-align-items: center;
              align-items: center;
      -webkit-box-pack: justify;
      -webkit-justify-content: space-between;
              justify-content: space-between;
      height: 100rpx;
      padding: 0 60rpx;
      background: #fff;
}
.user-container .my-fun-wrap .my-fun-item:last-child {
        border-bottom: 0;
}
.user-container .my-fun-wrap .is-open-index-ani {
      margin-bottom: 16rpx;
      border-bottom: 0;
}
.user-container .my-fun-wrap .is-open-index-ani .open-index-switch {
        -webkit-transform: scale(0.7, 0.7);
                transform: scale(0.7, 0.7);
}
.user-container .hover-current {
    background: #f4f4f4;
}
.user-container .big-avatar-wrap {
    width: 100%;
    height: 100%;
    -webkit-box-orient: vertical;
    -webkit-box-direction: normal;
    -webkit-flex-direction: column;
            flex-direction: column;
    position: fixed;
    left: 0;
    top: 0;
    z-index: 50;
}
.user-container .big-avatar-wrap .mask {
      width: 100%;
      height: 100%;
      position: absolute;
      left: 0;
      top: 0;
      background: rgba(0, 0, 0, 0.7);
}
.user-container .big-avatar-wrap .avatar-content {
      width: 100%;
      max-height: 80%;
      position: relative;
}
.user-container .big-avatar-wrap .avatar-content .big-user-avatar-wrap {
        width: 100%;
        max-height: 100%;
        overflow: scroll;
}
.user-container .big-avatar-wrap .avatar-content .big-user-avatar-wrap .big-user-avatar {
          display: block;
          max-width: 80%;
          margin: 0 auto;
}
.user-container .big-avatar-wrap .avatar-content .update-avatar-tip {
        padding: 30rpx 0;
        color: #fff;
        font-size: 24rpx;
}

