<view class="page_login"><block a:if="{{isShowNavBar}}"><navbar vue-id="1" onVueInit="__l"></navbar></block><view class="head-wrap flex flex-align flex-justify"><view class="head-bg flex flex-justify"><image class="head-logo" src="/static/family/family-logo.png"></image></view></view><view class="login_form flex flex-align flex-justify"><view class="input-wrap flex flex-align flex-justify"><view class="img"><image style="width:22px;height:22px;" src="/static/login/icon_user.png"></image></view><input type="text" placeholder="请输入家庭账号" data-event-opts="{{[['input',[['__set_model',['','familyName','$event',[]]]]]]}}" value="{{familyName}}" onInput="__e"/><view class="img"><image class="img_del" src="/static/login/clear-ipt.png" data-event-opts="{{[['tap',[['delUser',['$event']]]]]}}" onTap="__e"></image></view></view><view class="line"></view><view class="input-wrap flex flex-align flex-justify"><view class="img"><image style="width:18px;height:22px;" src="/static/login/icon_pwd.png"></image></view><input type="{{pwdType}}" placeholder="请输入家庭密码" data-event-opts="{{[['input',[['inputPwd',['$event']]]]]}}" value="{{userpwd}}" onInput="__e"/><view data-event-opts="{{[['tap',[['switchPwd',['$event']]]]]}}" class="img" onTap="__e"><image hidden="{{!(pwdType==='password')}}" class="img_pwd_switch" src="/static/login/close-pwd.png"></image><image hidden="{{!(pwdType==='text')}}" class="img_pwd_switch" src="/static/login/open-pwd.png"></image></view></view></view><button class="submit-login" type="primary" data-event-opts="{{[['tap',[['login',['$event']]]]]}}" onTap="__e">登录</button><view class="opts flex flex-align"><text data-event-opts="{{[['tap',[['goReg',['$event']]]]]}}" class="text to-reg" onTap="__e">家庭注册</text><text data-event-opts="{{[['tap',[['findPwd',['$event']]]]]}}" class="text" onTap="__e">忘记密码？</text></view></view>