<view class="set-wrap"><navbar vue-id="1" onVueInit="__l"><view slot="contentText">设置</view></navbar><view class="set-content"><view class="set-item" hover-class="hover-current" data-event-opts="{{[['tap',[['changePwd',['$event']]]]]}}" onTap="__e"><text>修改密码</text><text class="icons icon-jiantou_you f-right"></text></view><view class="set-item" hover-class="hover-current" data-event-opts="{{[['tap',[['clearStorage',['$event']]]]]}}" onTap="__e"><text>清空缓存</text><text class="icons icon-jiantou_you f-right"></text></view></view><change-pwd-com vue-id="2" isShowDialog="{{isShowPwdDialog}}" data-event-opts="{{[['^closeDialog',[['closeDialog']]],['^changePwdSuccess',[['changePwdSuccess']]]]}}" onCloseDialog="__e" onChangePwdSuccess="__e" onVueInit="__l"></change-pwd-com></view>