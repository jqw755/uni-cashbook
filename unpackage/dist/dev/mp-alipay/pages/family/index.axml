<view class="family-container data-v-9e4f724c"><view class="family-info-wrap flex flex-align flex-justify data-v-9e4f724c"><image class="family-info-bg data-v-9e4f724c" src="/static/family/default-head-bg.jpg" mode="aspectFill"></image><view class="family-head-wrap flex flex-align flex-justify data-v-9e4f724c"><navigator class="set-btn data-v-9e4f724c" url="/pages/family/set">设置</navigator><block a:if="{{familyData.familyAvatar}}"><image class="family-head data-v-9e4f724c" src="{{familyData.familyAvatar}}" mode></image></block><block a:else><image class="family-head data-v-9e4f724c" src="/static/family/family-logo.png" mode></image></block><view class="family-name data-v-9e4f724c">{{familyData.familyName||'--'}}</view><view class="family-tags data-v-9e4f724c">吃货家庭，开心，美食</view></view></view><view class="fun-wrap data-v-9e4f724c"><view class="fun-tab-wrap flex flex-align flex-justify data-v-9e4f724c"><block a:for="{{tabList}}" a:for-item="item" a:for-index="index" a:key="index"><text data-event-opts="{{[['tap',[['changeTab',['$0'],[[['tabList','',index,'id']]]]]]]}}" class="{{((('data-v-9e4f724c')+' '+'tab-item')+' '+[(item.id===currentTab)?'active':''])}}" onTap="__e">{{item.name}}</text></block></view><j-swiper vue-id="1" swiperLen="{{3}}" swiperIdx="{{currentTab}}" data-event-opts="{{[['^swiperChange',[['changeSwiper']]]]}}" onSwiperChange="__e" class="data-v-9e4f724c" onVueInit="__l"><view class="j-swiper-item data-v-9e4f724c"><family-member vue-id="{{('2')+','+('1')}}" familyData="{{familyData}}" data-event-opts="{{[['^toAddMember',[['addMember']]]]}}" onToAddMember="__e" class="data-v-9e4f724c" onVueInit="__l"></family-member></view><view class="j-swiper-item data-v-9e4f724c"><block a:for="{{orderList}}" a:for-item="item" a:for-index="index" a:key="index"><order-item vue-id="{{('3-'+index)+','+('1')}}" order-data="{{item}}" class="data-v-9e4f724c" onVueInit="__l"></order-item></block><block a:if="{{!orderList.length}}"><empty-data vue-id="{{('4')+','+('1')}}" noDataDesc="暂无订单" class="data-v-9e4f724c" onVueInit="__l"></empty-data></block></view><view class="j-swiper-item data-v-9e4f724c"><block a:if="{{!photos.length}}"><empty-data vue-id="{{('5')+','+('1')}}" noDataDesc="暂无相册" class="data-v-9e4f724c" onVueInit="__l"></empty-data></block></view></j-swiper></view><add-member vue-id="6" isShowDialog="{{isShowDialog}}" data-event-opts="{{[['^closeDialog',[['closeDialog']]],['^addMemberSuccess',[['addMemberSuccess']]]]}}" onCloseDialog="__e" onAddMemberSuccess="__e" class="data-v-9e4f724c" onVueInit="__l"></add-member></view>