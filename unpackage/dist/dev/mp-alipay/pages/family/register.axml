<view class="page_register"><block a:if="{{isShowNavBar}}"><navbar vue-id="1" onVueInit="__l"></navbar></block><view class="head-wrap flex ">创建您的家庭吧</view><view class="login_form flex flex-align flex-justify"><view class="input-wrap flex flex-align flex-justify"><input type="text" placeholder="请输入家庭账号" data-event-opts="{{[['input',[['__set_model',['','familyName','$event',[]]]]]]}}" value="{{familyName}}" onInput="__e"/><view class="img"><image class="img_del" src="/static/login/clear-ipt.png" data-event-opts="{{[['tap',[['delUser',['$event']]]]]}}" onTap="__e"></image></view></view><view class="line"></view><view class="input-wrap flex flex-align flex-justify"><input type="{{pwdType}}" placeholder="请输入家庭密码" data-event-opts="{{[['input',[['inputPwd',['$event']]]]]}}" value="{{password}}" onInput="__e"/><view data-event-opts="{{[['tap',[['switchPwd',['$event']]]]]}}" class="img" onTap="__e"><image hidden="{{!(pwdType==='password')}}" class="img_pwd_switch" src="/static/login/close-pwd.png"></image><image hidden="{{!(pwdType==='text')}}" class="img_pwd_switch" src="/static/login/open-pwd.png"></image></view></view><view class="line"></view></view><button class="submit-login" type="primary" disabled="{{isSubmiting}}" data-event-opts="{{[['tap',[['registerEvt',['$event']]]]]}}" onTap="__e">注册</button><view class="opts"><text data-event-opts="{{[['tap',[['goLogin',['$event']]]]]}}" class="text" onTap="__e">家庭登录</text></view></view>