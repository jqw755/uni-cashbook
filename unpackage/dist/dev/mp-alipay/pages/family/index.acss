.family-container.data-v-9e4f724c {
  width: 100%;
  background: #f4f4f4;
}
.family-container .family-info-wrap.data-v-9e4f724c {
    width: 100%;
    height: 420rpx;
    overflow: hidden;
    position: relative;
}
.family-container .family-info-wrap .family-info-bg.data-v-9e4f724c {
      width: 100%;
      position: absolute;
      left: 0;
      top: 0;
      z-index: 1;
}
.family-container .family-info-wrap .family-head-wrap.data-v-9e4f724c {
      width: 100%;
      height: 100%;
      position: relative;
      -webkit-box-orient: vertical;
      -webkit-box-direction: normal;
      -webkit-flex-direction: column;
              flex-direction: column;
      z-index: 2;
      background: rgba(0, 0, 0, 0.22);
}
.family-container .family-info-wrap .family-head-wrap .set-btn.data-v-9e4f724c {
        color: #ddd;
        font-size: 24rpx;
        position: absolute;
        right: 32rpx;
        top: 20rpx;
}
.family-container .family-info-wrap .family-head-wrap .family-head.data-v-9e4f724c {
        width: 140rpx;
        max-height: 140rpx;
        border: 4rpx solid #fff;
        border-radius: 50%;
        overflow: hidden;
        box-shadow: 0 0 4rpx 4rpx rgba(0, 0, 0, 0.1);
}
.family-container .family-info-wrap .family-head-wrap .family-name.data-v-9e4f724c {
        color: #fff;
        margin: 30rpx 0;
}
.family-container .family-info-wrap .family-head-wrap .family-tags.data-v-9e4f724c {
        font-size: 24rpx;
        color: #fff;
        padding: 6rpx 20rpx;
        background: rgba(0, 0, 0, 0.4);
        border-radius: 200rpx;
}
.family-container .fun-wrap .j-swiper-item.data-v-9e4f724c {
    min-height: calc(100vh - 530rpx);
    background: #fff;
}
.family-container .fun-wrap .fun-tab-wrap.data-v-9e4f724c {
    background: #fff;
    margin-bottom: 30rpx;
}
.family-container .fun-wrap .fun-tab-wrap .tab-item.data-v-9e4f724c {
      text-align: center;
      -webkit-flex-basis: 100rpx;
              flex-basis: 100rpx;
      height: 80rpx;
      line-height: 80rpx;
      color: gray;
      font-size: 26rpx;
      position: relative;
}
.family-container .fun-wrap .fun-tab-wrap .tab-item.active.data-v-9e4f724c {
        color: orange;
}
.family-container .fun-wrap .fun-tab-wrap .tab-item.active.data-v-9e4f724c:after {
          content: '';
          display: block;
          width: 40%;
          height: 4rpx;
          background: orange;
          position: absolute;
          left: 50%;
          -webkit-transform: translateX(-50%);
                  transform: translateX(-50%);
          bottom: 0;
}
.family-container .fun-wrap .fun-list.data-v-9e4f724c {
    background: #fff;
}
.family-container .fun-wrap .fun-list .fun-item.data-v-9e4f724c {
      display: -webkit-box;
      display: -webkit-flex;
      display: flex;
      -webkit-box-align: center;
      -webkit-align-items: center;
              align-items: center;
      height: 100rpx;
      padding: 0 32rpx;
      border-bottom: 1px solid #f1f1f1;
}
.family-container .fun-wrap .fun-list .fun-item.data-v-9e4f724c:last-child {
        border-bottom: 0;
}
.family-container .fun-wrap .fun-list .fun-item.hover-fun.data-v-9e4f724c {
        background: #f4f4f4;
}

