<view class="member-wrap data-v-df512a66"><view class="balance-wrap data-v-df512a66"><view class="money-title data-v-df512a66"><text class="data-v-df512a66">当前余额（元）</text></view><view class="money-count data-v-df512a66">{{familyData.balance}}</view><view class="money-tip data-v-df512a66">（账户金额由家庭成员充值，点此<text data-event-opts="{{[['tap',[['loginMember',['$event']]]]]}}" class="login-member data-v-df512a66" onTap="__e">切换</text>到家庭成员）</view></view><view class="title flex member-title data-v-df512a66"><text class="data-v-df512a66">成员</text><image class="add-member-icon data-v-df512a66" src="/static/family/add-user.png" mode data-event-opts="{{[['tap',[['addMember',['$event']]]]]}}" onTap="__e"></image></view><view class="member-list flex data-v-df512a66"><block a:for="{{familyData.members}}" a:for-item="item" a:for-index="index" a:key="index"><view data-event-opts="{{[['tap',[['queryMember',['$0'],[[['familyData.members','',index]]]]]]]}}" class="member-item text-center data-v-df512a66" onTap="__e"><view class="member-avatar-wrap data-v-df512a66"><block a:if="{{item.avatar}}"><image class="member-avatar data-v-df512a66" src="{{item.avatar}}" mode="widthFix"></image></block><block a:else><image class="member-avatar data-v-df512a66" src="/static/contact-avatar.png" mode="widthFix"></image></block></view><view class="member-name text-overflow data-v-df512a66">{{item.userName}}</view></view></block></view><block a:if="{{!familyData.members||!familyData.members.length}}"><view class="no-member-wrap data-v-df512a66"><empty-data vue-id="1" noDataDesc="暂无成员" class="data-v-df512a66" onVueInit="__l"></empty-data></view></block></view>