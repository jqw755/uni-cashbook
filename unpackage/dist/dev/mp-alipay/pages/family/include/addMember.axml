<view><j-dialog vue-id="1" isShowDialog="{{isShowDialog}}" isShowCancelBtn="{{true}}" isMaskClose="{{false}}" data-event-opts="{{[['^closeDialog',[['closeDialog']]],['^confirmDialog',[['registerEvt']]]]}}" onCloseDialog="__e" onConfirmDialog="__e" onVueInit="__l"><text slot="title">添加家庭成员</text><view slot="content"><view class="member-register"><view class="login_form flex flex-align flex-justify"><view class="input-wrap flex flex-align flex-justify"><input type="text" placeholder="请输入账号" data-event-opts="{{[['input',[['__set_model',['','username','$event',[]]]]]]}}" value="{{username}}" onInput="__e"/><view class="img"><image class="img_del" src="/static/login/clear-ipt.png" data-event-opts="{{[['tap',[['delUser',['$event']]]]]}}" onTap="__e"></image></view></view><view class="line"></view><view class="input-wrap flex flex-align flex-justify"><input type="{{pwdType}}" placeholder="请输入密码" data-event-opts="{{[['input',[['inputPwd',['$event']]]]]}}" value="{{userpwd}}" onInput="__e"/><view data-event-opts="{{[['tap',[['switchPwd',['$event']]]]]}}" class="img" onTap="__e"><image hidden="{{!(pwdType==='password')}}" class="img_pwd_switch" src="/static/login/close-pwd.png"></image><image hidden="{{!(pwdType==='text')}}" class="img_pwd_switch" src="/static/login/open-pwd.png"></image></view></view><view class="line"></view></view></view></view></j-dialog></view>