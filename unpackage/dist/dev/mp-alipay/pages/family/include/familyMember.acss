.member-wrap .title.data-v-df512a66 {
  color: #999;
  padding: 20rpx 40rpx;
  background: #fff;
  -webkit-box-pack: justify;
  -webkit-justify-content: space-between;
          justify-content: space-between;
}
.member-wrap .title .add-member-icon.data-v-df512a66 {
    width: 40rpx;
    height: 40rpx;
}
.member-wrap .title.member-title.data-v-df512a66 {
    color: #5e35b3;
}
.member-wrap .balance-wrap.data-v-df512a66 {
  padding: 30rpx 40rpx;
  margin: 20rpx 20rpx;
  background: #2dc478;
  border-top-left-radius: 30rpx;
  border-top-right-radius: 30rpx;
  color: #fff;
}
.member-wrap .balance-wrap .money-title.data-v-df512a66 {
    font-size: 26rpx;
    margin-bottom: 10rpx;
}
.member-wrap .balance-wrap .money-count.data-v-df512a66 {
    font-weight: bold;
    font-size: 56rpx;
}
.member-wrap .balance-wrap .money-tip.data-v-df512a66 {
    font-size: 24rpx;
}
.member-wrap .balance-wrap .money-tip .login-member.data-v-df512a66 {
      color: orange;
      text-decoration: underline;
      margin: 0 6rpx;
}
.member-wrap .member-list.data-v-df512a66 {
  background: #fff;
  -webkit-flex-wrap: wrap;
          flex-wrap: wrap;
}
.member-wrap .member-list .member-item.data-v-df512a66 {
    margin-left: 40rpx;
}
.member-wrap .member-list .member-item .member-avatar-wrap.data-v-df512a66 {
      width: 100rpx;
      height: 100rpx;
      border-radius: 50%;
      overflow: hidden;
}
.member-wrap .member-list .member-item .member-avatar-wrap .member-avatar.data-v-df512a66 {
        width: 100%;
        max-height: 100%;
}
.member-wrap .member-list .member-item .member-name.data-v-df512a66 {
      max-width: 100rpx;
      padding: 10rpx 0;
      font-size: 24rpx;
}

