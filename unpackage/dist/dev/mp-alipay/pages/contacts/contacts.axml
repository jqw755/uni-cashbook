<view class="container"><navbar vue-id="1" onVueInit="__l"><view slot="contentText">联系人</view></navbar><view class="contacts-wrap"><scroll-view class="contacts-swiper-wrap" style="{{'height:'+('calc(100vh - '+customeBarH+'px)')+';'}}" scroll-y scroll-into-view="{{'index-'+indexCur}}" scroll-with-animation enable-back-to-top><block a:for="{{contactData}}" a:for-item="list" a:for-index="letter" a:key="letter"><view id="{{'index-'+letter}}"><view class="letter-wrap flex flex-align">{{letter}}</view><view class="contact-people-wrap"><block a:for="{{list}}" a:for-item="item" a:for-index="index" a:key="index"><view class="contact-people-item flex flex-align"><image class="contact-avatar" src="/static/contact-avatar.png" mode></image><view class="contact-people">{{item.name}}</view></view></block></view></view></block></scroll-view><view class="contacts-index-wrap flex flex-align flex-justify" style="{{'height:'+('calc(100vh - '+customeBarH+'px)')+';'}}"><view data-event-opts="{{[['touchStart',[['touchUlStart',['$event']]]],['touchMove',[['touchUlMove',['$event']]]],['touchEnd',[['touchUlEnd',['$event']]]]]}}" class="contacts-ul box-shadow _ul" onTouchStart="__e" onTouchMove="__e" catchTouchEnd="__e"><block a:for="{{contactIndexData}}" a:for-item="item" a:for-index="index" a:key="index"><view class="index-item flex flex-align flex-justify _li" data-id="{{item}}" data-event-opts="{{[['touchStart',[['touchIdxItem',['$event']]]]]}}" onTouchStart="__e">{{item}}</view></block></view></view><view hidden="{{!(isShowTipBox)}}" class="index-tip-wrap flex flex-align flex-justify">{{indexCur}}</view></view></view>