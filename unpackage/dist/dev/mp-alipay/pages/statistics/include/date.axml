<view class="flex flex-align"><view class="choose-date-type"><picker value="{{dataIndex}}" range="{{dateView}}" data-event-opts="{{[['change',[['chooseDateType',['$event']]]]]}}" onChange="__e"><view class="view-text">{{dateView[dataIndex]}}</view></picker></view><view class="date-popup"><picker mode="date" fields="{{dateFields}}" value="{{dateResult}}" start="{{startDate}}" end="{{endDate}}" data-event-opts="{{[['change',[['bindDateChange',['$event']]]]]}}" onChange="__e"><text class="date-text">{{dateResult||'请选择日期'}}</text></picker></view></view>