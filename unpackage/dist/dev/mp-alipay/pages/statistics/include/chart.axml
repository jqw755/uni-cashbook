<view class="charts-content-wrap"><view class="qiun-columns"><view class="qiun-charts"><canvas class="charts" canvas-id="canvasArea" id="canvasArea" disable-scroll="true" data-event-opts="{{[['touchStart',[['touchArea',['$event']]]],['touchMove',[['moveArea',['$event']]]],['touchEnd',[['touchEndArea',['$event']]]]]}}" onTouchStart="__e" onTouchMove="__e" onTouchEnd="__e"></canvas></view></view></view>