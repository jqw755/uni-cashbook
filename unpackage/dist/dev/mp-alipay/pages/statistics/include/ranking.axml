<view class="ranking-wrap"><view class="ranking-wrap-item top-ranking-wrap"><view class="ranking-title-wrap flex flex-align"><view class="ranking-title"><text class="title-word">TOP</text><text class="title-box-shadow"></text><text class="title-desc"><text hidden="{{!(rankingDateType===0)}}">月</text><text hidden="{{!(rankingDateType===1)}}">年</text><text hidden="{{!(swiperIndex===0)}}">收入</text><text hidden="{{!(swiperIndex===1)}}">支出</text>榜前十</text></view><view data-event-opts="{{[['tap',[['changeRanking',['$event']]]]]}}" class="change-ranking-btn icons icon-qiehuan" onTap="__e">切换榜单</view></view><swiper class="ranking-order-swiper" current="{{swiperIndex}}"><swiper-item><block a:for="{{rankingTopOrders}}" a:for-item="item" a:for-index="index" a:key="index"><view class="ranking-order-item"><order-item vue-id="{{'1-'+index}}" order-data="{{item}}" onVueInit="__l"></order-item></view></block></swiper-item><swiper-item><block a:for="{{rankingLastOrders}}" a:for-item="item" a:for-index="index" a:key="index"><view class="ranking-order-item"><order-item vue-id="{{'2-'+index}}" order-data="{{item}}" onVueInit="__l"></order-item></view></block></swiper-item></swiper></view></view>