<view class="container statistics-container"><view class="by-wrap by-date-wrap"><view class="by-title-wrap"><text class="by-title-tip">日期</text><text class="by-title-desc">按日期查看走势</text></view><view class="date-com-wrap"><by-date onChooseDateView="__e" onChooseDate="__e" vue-id="1" data-event-opts="{{[['^chooseDateView',[['chooseDateView']]],['^chooseDate',[['chooseDate']]]]}}" onVueInit="__l"></by-date></view></view><view class="by-wrap by-cate-wrap"><view class="by-title-wrap"><text class="by-title-tip cate-title">分类</text><text class="by-title-desc">按收入/支出查看走势</text></view><view class="cate-list-wrap"><view class="cate-item-wrap by-income-wrap"><view data-event-opts="{{[['tap',[['tapCateTitle',[1]]]]]}}" class="by-cate-title flex flex-align" onTap="__e"><text>{{"收入："+incomeSelObj.name}}</text><text class="{{(('icons icon-arrow-down icon-xiajiantou')+' '+[(isShowIncome)?'icon-rotate':''])}}"></text></view><view class="{{(('page-cate-list-wrap')+' '+[(isShowIncome)?'down':''])}}"><view class="page-cate-list-content"><income onChooseIncome="__e" vue-id="2" data-event-opts="{{[['^chooseIncome',[['chooseIncome']]]]}}" onVueInit="__l"></income></view></view></view><view class="cate-item-wrap by-expenditure-wrap"><view data-event-opts="{{[['tap',[['tapCateTitle',[2]]]]]}}" class="by-cate-title flex flex-align" onTap="__e"><text>{{"支出："+expenditureSelObj.name}}</text><text class="{{(('icons icon-arrow-down icon-xiajiantou')+' '+[(isShowExpend)?'icon-rotate':''])}}"></text></view><view class="{{(('page-cate-list-wrap')+' '+[(isShowExpend)?'down':''])}}"><view class="page-cate-list-content"><expenditure onChooseExpenditure="__e" vue-id="3" data-event-opts="{{[['^chooseExpenditure',[['chooseExpenditure']]]]}}" onVueInit="__l"></expenditure></view></view></view></view></view><chart vue-id="4" onVueInit="__l"></chart><ranking vue-id="5" rankingTopOrders="{{rankingTopOrders}}" rankingLastOrders="{{rankingLastOrders}}" rankingDateType="{{rankingDateType}}" onVueInit="__l"></ranking></view>