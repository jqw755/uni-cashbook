/* 垂直间距 */
/* 透明度 */
/* 文章场景相关 */
.statistics-container {
  background: #fff;
}
.statistics-container .by-wrap .by-title-wrap {
    padding: 20rpx 20rpx;
    background: #f4f4f4;
}
.statistics-container .by-wrap .by-title-wrap .by-title-tip {
      font-size: 40rpx;
      font-weight: bold;
      margin-right: 20rpx;
      padding-left: 16rpx;
      position: relative;
      color: #000;
}
.statistics-container .by-wrap .by-title-wrap .by-title-tip::before {
        content: '';
        display: block;
        width: 8rpx;
        height: 80%;
        background: #1fd7bd;
        position: absolute;
        left: 0;
        top: 10%;
        border-radius: 4rpx;
}
.statistics-container .by-wrap .by-title-wrap .by-title-tip.cate-title::before {
        background: #ffde3f;
}
.statistics-container .by-wrap .by-title-wrap .by-title-desc {
      color: #999;
      font-size: 26rpx;
}
.statistics-container .by-wrap.by-date-wrap .date-com-wrap {
    padding: 32rpx 52rpx;
}
.statistics-container .by-wrap.by-cate-wrap {
    margin-bottom: 40rpx;
}
.statistics-container .by-wrap.by-cate-wrap .cate-list-wrap {
      padding: 32rpx 52rpx;
}
.statistics-container .by-wrap.by-cate-wrap .cate-list-wrap .cate-item-wrap .by-cate-title {
        height: 80rpx;
        -webkit-box-pack: justify;
        -webkit-justify-content: space-between;
                justify-content: space-between;
        border-bottom: 1px solid #ddd;
}
.statistics-container .by-wrap.by-cate-wrap .cate-list-wrap .cate-item-wrap .by-cate-title:last-child {
          border-bottom: 0;
}
.statistics-container .by-wrap.by-cate-wrap .cate-list-wrap .cate-item-wrap .by-cate-title .icon-arrow-down {
          -webkit-transition: all 400ms;
          transition: all 400ms;
}
.statistics-container .by-wrap.by-cate-wrap .cate-list-wrap .cate-item-wrap .by-cate-title .icon-arrow-down.icon-rotate {
            -webkit-transform: rotate(180deg);
                    transform: rotate(180deg);
}
.statistics-container .by-wrap.by-cate-wrap .cate-list-wrap .cate-item-wrap .page-cate-list-wrap {
        background: #f4f4f4;
        border-radius: 10rpx;
        -webkit-transition: height 300ms;
        transition: height 300ms;
        overflow: hidden;
        height: 0;
}
.statistics-container .by-wrap.by-cate-wrap .cate-list-wrap .cate-item-wrap .page-cate-list-wrap .page-cate-list-content {
          padding: 20rpx 20rpx;
}
.statistics-container .by-wrap.by-cate-wrap .cate-list-wrap .cate-item-wrap .page-cate-list-wrap.down {
          height: 200rpx;
          overflow: scroll;
}
@-webkit-keyframes foldUp {
from {
    height: 0;
}
to {
    height: auto;
}
}
@keyframes foldUp {
from {
    height: 0;
}
to {
    height: auto;
}
}
@-webkit-keyframes foldDown {
from {
    height: auto;
}
to {
    height: 0;
}
}
@keyframes foldDown {
from {
    height: auto;
}
to {
    height: 0;
}
}

