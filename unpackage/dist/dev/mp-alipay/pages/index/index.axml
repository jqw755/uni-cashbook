<view class="container"><view class="page-top-wrap"><view class="page-top-content flex"><rili vue-id="1" onVueInit="__l"></rili><view class="balance-wrap text-center"><view class="balance-content "><text class="money-tip">￥</text><text class="money-num">{{$store.state.userInfo.balance}}</text></view><view class="balance-tip "><text class="icons icon-qianbao"></text><text>当前余额</text></view></view><view></view></view><block a:if="{{$store.state.isOpenIndexAni}}"><bolang vue-id="2" onVueInit="__l"></bolang></block><block a:else><view class="no-bolang-view"></view></block></view><view class="page-middle-wrap"><view class="last-order-title flex flex-align"><text class="title">最新</text><navigator class="more-order-title" url="/pages/order/orderList" hover-class="a-hover"><text>查看更多</text><text class="icons icon-jiantou_you"></text></navigator></view><view class="order-list-wrap"><block a:for="{{orderList}}" a:for-item="item" a:for-index="index" a:key="index"><order-item vue-id="{{'3-'+index}}" order-data="{{item}}" onVueInit="__l"></order-item></block><block a:if="{{!orderList.length}}"><view class="index-page-no-data"><empty-data vue-id="4" noDataDesc="暂无订单" onVueInit="__l"></empty-data></view></block></view></view><view data-event-opts="{{[['tap',[['bookkeepEvt',['$event']]]]]}}" class="{{(('bookkeep-btn-wrap flex flex-align flex-justify')+' '+[(isPageScroll)?'pull-over':''])}}" onTap="__e"><image class="bookkeep-img" src="/static/bookkeeping.png"></image></view></view>