@charset "UTF-8";
/**
 * 这里是uni-app内置的常用样式变量
 *
 * uni-app 官方扩展插件及插件市场（https://ext.dcloud.net.cn）上很多三方插件均使用了这些样式变量
 * 如果你是插件开发者，建议你使用scss预处理，并在插件代码中直接使用这些变量（无需 import 这个文件），方便用户通过搭积木的方式开发整体风格一致的App
 *
 */
/**
 * 如果你是App开发者（插件使用者），你可以通过修改这些变量来定制自己的插件主题，实现自定义主题功能
 *
 * 如果你的项目同样使用了scss预处理，你也可以直接在你的 scss 代码中使用如下变量，同时无需 import 这个文件
 */
/* 颜色变量 */
/* 行为相关颜色 */
/* 文字基本颜色 */
/* 背景颜色 */
/* 边框颜色 */
/* 分割线颜色 */
/* 尺寸变量 */
/* 文字尺寸 */
/* 图片尺寸 */
/* Border Radius */
/* 水平间距 */
/* 垂直间距 */
/* 透明度 */
/* 文章场景相关 */
.page-top-wrap {
  width: 100%;
  height: 400rpx;
  position: relative;
}
.page-top-wrap .page-top-content {
    width: 100%;
    height: 100%;
    padding: 32rpx 32rpx;
    position: absolute;
    left: 0;
    top: 0;
    z-index: 10;
}
.page-top-wrap .page-top-content .balance-wrap {
      width: 100%;
      position: absolute;
      left: 50%;
      top: 50%;
      -webkit-transform: translate(-50%, -50%);
              transform: translate(-50%, -50%);
}
.page-top-wrap .page-top-content .balance-wrap .balance-content {
        font-size: 36rpx;
        font-weight: bold;
}
.page-top-wrap .page-top-content .balance-wrap .balance-content .money-tip {
          margin-left: -24rpx;
}
.page-top-wrap .page-top-content .balance-wrap .balance-content .money-num {
          font-size: 80rpx;
}
.page-top-wrap .page-top-content .balance-wrap .balance-tip {
        color: #a4a4a4;
}
.page-top-wrap .page-top-content .balance-wrap .balance-tip .icon-qianbao {
          color: #ddca26;
}
.page-top-wrap .no-bolang-view {
    width: 100%;
    height: 100%;
    background-image: -webkit-linear-gradient(250deg, #007851, #14a032);
    background-image: linear-gradient(200deg, #007851, #14a032);
}
.page-middle-wrap .last-order-title {
  width: 100%;
  -webkit-box-pack: justify;
  -webkit-justify-content: space-between;
          justify-content: space-between;
  padding: 24rpx 32rpx 24rpx 32rpx;
  background: #e5e5e5;
  position: -webkit-sticky;
  position: sticky;
  top: 0;
}
.page-middle-wrap .last-order-title .title {
    font-size: 40rpx;
    color: #000;
}
.page-middle-wrap .last-order-title .more-order-title {
    -webkit-align-self: flex-end;
            align-self: flex-end;
    color: #666;
}
.page-middle-wrap .index-page-no-data {
  margin-top: 150rpx;
}
.bookkeep-btn-wrap {
  width: 90rpx;
  height: 90rpx;
  background: #3fbc62;
  border-radius: 200rpx;
  position: fixed;
  right: 32rpx;
  bottom: 160rpx;
  box-shadow: 0 0 6rpx 4rpx rgba(0, 0, 0, 0.1);
  -webkit-transition: -webkit-transform 300ms ease;
  transition: -webkit-transform 300ms ease;
  transition: transform 300ms ease;
  transition: transform 300ms ease, -webkit-transform 300ms ease;
}
.bookkeep-btn-wrap .bookkeep-img {
    width: 44rpx;
    height: 44rpx;
}
.bookkeep-btn-wrap.pull-over {
    -webkit-transform: translateX(90rpx);
            transform: translateX(90rpx);
}

