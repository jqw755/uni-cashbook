<view class="container order-list-container"><navbar vue-id="1" onVueInit="__l"><view slot="contentText">账单列表</view></navbar><block a:for="{{orderList}}" a:for-item="item" a:for-index="index" a:key="index"><view class="list-item"><order-item vue-id="{{'2-'+index}}" order-data="{{item}}" onVueInit="__l"></order-item></view></block><block a:if="{{!pageLoading&&!orderList.length}}"><empty-data vue-id="3" noDataDesc="暂无订单" onVueInit="__l"></empty-data></block></view>