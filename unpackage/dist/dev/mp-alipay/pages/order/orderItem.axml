<navigator class="order-item-wrap flex flex-align" url="{{'/pages/order/orderDetail?orderNo='+orderData._id}}" hover-class="none"><view class="order-type-icon"><image class="order-type-img" src="/static/cate/canyin.png" mode></image></view><view class="order-data-wrap flex"><view class="data-left"><view class="cate-str">{{orderData.cateStr||'--'}}</view><view class="order-ramark">{{orderData.remark||'--'}}</view><view class="time">{{formatTime||'--'}}</view></view><view class="{{(('order-money-wrap')+' '+[(orderData.orderType===2)?'active':''])}}"><block a:if="{{orderData.orderType===1}}"><text>-</text></block><block a:if="{{orderData.orderType===2}}"><text>+</text></block><text class="money-num">{{orderData.money}}</text></view></view></navigator>