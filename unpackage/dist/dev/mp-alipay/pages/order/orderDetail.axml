<view class="container order-detail-container"><navbar vue-id="1" onVueInit="__l"><view slot="contentText">详情</view></navbar><view class="order-detail-wrap"><view class="order-detail-top text-center"><view class="detail-top-item"><image class="order-icon-wrap" src="../../static/cate/canyin.png" mode></image></view><view class="detail-top-item order-title">{{orderData.cateStr||'--'}}</view><view class="detail-top-item order-money"><block a:if="{{orderData.orderType===1}}"><text>-</text></block><block a:if="{{orderData.orderType===2}}"><text>+</text></block><text class="money-num">{{orderData.money}}</text></view></view><view class="order-detail-bottom _ul"><view class="detail-item _li"><text class="detail-tip">当前状态</text><text>{{orderData.orderState===1?'已完成':'未知'}}</text></view><view class="detail-item _li"><text class="detail-tip">支付方式</text><text>本APP支付</text></view><view class="detail-item _li"><text class="detail-tip">消费时间</text><text>{{orderData.payTime||'--'}}</text></view><view class="detail-item _li"><text class="detail-tip">订单创建时间</text><text>{{orderData.createTime||'--'}}</text></view><view class="detail-item _li"><text class="detail-tip" selectable="{{true}}">订单号</text><text>{{orderData['_id']||'--'}}</text></view><view class="detail-item _li"><text class="detail-tip">订单备注</text><text>{{orderData.remark||'--'}}</text></view><view class="detail-item _li"><text class="detail-tip">照片</text><view class="order-pics"></view></view></view></view></view>