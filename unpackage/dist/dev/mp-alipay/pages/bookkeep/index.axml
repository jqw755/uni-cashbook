<view class="bookkeep-wrap"><navbar vue-id="1" bgImage="linear-gradient(-90deg, #3dbd4d, #e2b229)" onVueInit="__l"><text slot="backText">记账</text></navbar><view class="type-tab-wrap flex flex-align flex-justify"><block a:for="{{tabList}}" a:for-item="item" a:for-index="index" a:key="index"><text data-event-opts="{{[['tap',[['changeTab',['$0'],[[['tabList','',index,'id']]]]]]]}}" class="{{(('tab-item')+' '+[(item.id===currentTab)?'active':''])}}" onTap="__e">{{item.name}}</text></block></view><swiper class="type-swiper" duration="300" current="{{currentTab}}" data-event-opts="{{[['change',[['slideSwiper',['$event']]]]]}}" onChange="__e"><swiper-item><expenditure onChooseExpenditure="__e" vue-id="2" data-event-opts="{{[['^chooseExpenditure',[['chooseExpenditure']]]]}}" onVueInit="__l"></expenditure></swiper-item><swiper-item><income onChooseIncome="__e" vue-id="3" data-event-opts="{{[['^chooseIncome',[['chooseIncome']]]]}}" onVueInit="__l"></income></swiper-item></swiper><view class="form-wrap"><view class="form-item"><view class="item-title">{{tabList[currentTab].name+"金额（元）"}}</view><input class="item-ipt" type="digit" placeholder="请输入金额" data-event-opts="{{[['input',[['__set_model',['','money','$event',[]]]]]]}}" value="{{money}}" onInput="__e"/></view><view class="form-item"><view class="item-title">{{tabList[currentTab].name+"时间"}}</view><view data-event-opts="{{[['tap',[['openDatetimePicker',['$event']]]]]}}" class="{{(('item-ipt')+' '+[(!payTime)?'no-sel-time':''])}}" onTap="__e">{{payTime?payTime:'请选择时间'}}</view></view><view class="form-item"><view class="item-title">备注</view><textarea class="item-ipt item-text-area" placeholder="请输入备注" maxlength="200" data-event-opts="{{[['input',[['__set_model',['','remark','$event',[]]]]]]}}" value="{{remark}}" onInput="__e"></textarea></view><view class="submit-form text-center" hover-class="hover-class" data-event-opts="{{[['tap',[['submitFormEvt',['$event']]]]]}}" onTap="__e">提交</view></view><date-time-picker onSubmit="__e" vue-id="4" ref="__r" data-ref="myPicker" data-event-opts="{{[['^submit',[['dateTimeSubmit']]]]}}" onVueInit="__l"></date-time-picker></view>