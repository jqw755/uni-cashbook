/* 文章场景相关 */
.bookkeep-wrap {
  width: 100%;
  background: #f4f4f4;
}
.bookkeep-wrap .type-tab-wrap {
    background: #fff;
    padding-bottom: 20rpx;
}
.bookkeep-wrap .type-tab-wrap .tab-item {
      text-align: center;
      -webkit-flex-basis: 100rpx;
              flex-basis: 100rpx;
      height: 80rpx;
      line-height: 80rpx;
      color: gray;
      font-size: 26rpx;
      position: relative;
}
.bookkeep-wrap .type-tab-wrap .tab-item.active {
        color: orange;
}
.bookkeep-wrap .type-tab-wrap .tab-item.active:after {
          content: '';
          display: block;
          width: 40%;
          height: 4rpx;
          background: orange;
          position: absolute;
          left: 50%;
          -webkit-transform: translateX(-50%);
                  transform: translateX(-50%);
          bottom: 10rpx;
}
.bookkeep-wrap .type-swiper {
    padding: 0 40rpx;
    background: #fff;
    margin-bottom: 14rpx;
}
.bookkeep-wrap .form-wrap {
    padding: 32rpx 32rpx;
    background: #fff;
}
.bookkeep-wrap .form-wrap .form-item {
      margin-bottom: 30rpx;
}
.bookkeep-wrap .form-wrap .form-item .item-title {
        font-size: 30rpx;
        color: #888;
}
.bookkeep-wrap .form-wrap .form-item .item-ipt {
        font-size: 34rpx;
        height: 100rpx;
        line-height: 100rpx;
        border-bottom: 1px solid #ddd;
}
.bookkeep-wrap .form-wrap .form-item .item-text-area {
        width: 100%;
        padding-top: 20rpx;
        height: 200rpx;
        line-height: 44rpx;
}
.bookkeep-wrap .form-wrap .form-item .no-sel-time {
        color: #888;
}
.bookkeep-wrap .form-wrap .submit-form {
      width: 80%;
      padding: 20rpx 0;
      background: #32c55d;
      color: #fff;
      margin: 60rpx auto;
      box-shadow: 0 0 10rpx 4rpx rgba(0, 0, 0, 0.1);
      border-radius: 200rpx;
}
.bookkeep-wrap .form-wrap .submit-form.hover-class {
        background: #31a854;
}

